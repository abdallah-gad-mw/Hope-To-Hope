# Strapi v5 Headless API URL Integration
# Provide your production URL (e.g., https://strapi-domain.com) to route all site content fetches dynamically to Strapi.
# Leave blank to run with the fully integrated standalone filesystem CMS.
VITE_STRAPI_API_URL=

# MySQL Database configuration params for standalone persistent synchronization
DATABASE_CLIENT=mysql
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true
